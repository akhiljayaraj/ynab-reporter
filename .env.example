# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real token.

# Required: your YNAB personal access token.
# Generate a fresh one in YNAB -> Account Settings -> Developer Settings -> New Token
# (https://app.ynab.com/settings/developer).
YNAB_API_TOKEN=your_new_ynab_token_here

# YNAB_BUDGET_ID is required; the rest are optional.
YNAB_BUDGET_ID=your_budget_id_here
# YNAB_BASE_URL=https://api.ynab.com/v1
YNAB_RECIPIENTS=you@example.com,someone-else@example.com
